---
import '../styles/global.css'
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>CASSETTE.CSS</title>
	</head>
	<body class="bg-gray-900 font-mono text-[#F5F5DC] min-h-screen relative overflow-x-hidden">
		<div class="fixed inset-0 pointer-events-none z-0 opacity-20">
			<div class="absolute inset-0" style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,165,0,0.03) 2px, rgba(255,165,0,0.03) 4px)"></div>
		</div>
		<div class="fixed inset-0 pointer-events-none z-0 opacity-5">
			<div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,165,0,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,165,0,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
		</div>
		<slot />
	</body>
</html>
