      css=`
      .mech-radio-stack {
  display: flex;
  flex-direction: column;
  gap: 40px;
  padding: 20px;
  font-family: 'Courier New', monospace;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.label-tech {
  font-size: 11px;
  font-weight: bold;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.radio-pads {
  display: flex;
  gap: 10px;
}

.pad-item input {
  display: none;
}

.pad-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 45px;
  background: #f1ebd8;
  color: #4a4a4a;
  font-weight: bold;
  font-size: 11px;
  border-radius: 4px;
  cursor: pointer;
  box-shadow: 0 5px 0 #d8d0ba, 0 5px 10px rgba(0,0,0,0.1);
  transition: all 0.1s;
}

.pad-item input:checked + .pad-surface {
  background: #d65a31;
  color: #fff;
  transform: translateY(3px);
  box-shadow: 0 2px 0 #a94125;
}

.radio-leds {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.led-item {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.led-item input {
  display: none;
}

.led-indicator {
  width: 12px;
  height: 12px;
  background: #222;
  border-radius: 50%;
  border: 2px solid #444;
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
  transition: all 0.2s;
  position: relative;
}

.led-text {
  font-size: 13px;
  font-weight: bold;
  color: #666;
}

.led-item input:checked + .led-indicator {
  background: #00ff41;
  border-color: #00ff41;
  box-shadow: 0 0 10px rgba(0, 255, 65, 0.6), inset 0 0 4px #fff;
}

.led-item input:checked ~ .led-text {
  color: #222;
}
