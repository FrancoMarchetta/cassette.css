---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CassetteComponent from "../components/CassetteComponent.astro";
import "../styles/Buttons.css";
import "../styles/check-box.css";
import "../styles/selects.css";
import "../styles/inputs.css";
import "../styles/cards.css";
import "../styles/tables.css";
import "../styles/progress.css";
import "../styles/dialog.css";
import "../styles/badges.css";
import "../styles/text-area.css";
import "../styles/radio-buttons.css";
---

<Layout>
  <div class="mb-8">
    <Header />
  </div>

  <div class="page-content max-w-6xl mx-auto px-4">
<!-- Buttons -->
<div class="mech-demo-container">
  <div class="section-title">Buttons</div>
  <div class="buttons-container justify-center">
    <button class="keycap keycap-cream">ESC</button>

    <button class="keycap keycap-grey">ENTER</button>

    <button class="keycap keycap-orange">SHIFT</button>
  </div>
</div>

<div class="mech-demo-container">
  <div class="section-title">Check Boxes</div>
  <div class="mech-switch-stack justify-center">
    <div class="switch-field">
      <label>Keycap Toggle</label>
      <label class="mech-key-check">
        <input type="checkbox" />
        <span class="key-surface"></span>
      </label>
    </div>

    <div class="switch-field">
      <label>Industrial Slider</label>
      <label class="mech-slider">
        <input type="checkbox" />
        <span class="slider-track">
          <span class="slider-knob"></span>
        </span>
      </label>
    </div>

    <div class="switch-field">
      <label>Status LED</label>
      <label class="mech-led-btn">
        <input type="checkbox" />
        <span class="led-body"></span>
      </label>
    </div>
  </div>
</div>

<div class="mech-demo-container">
  <div class="section-title">Selects</div>
  <div class="justify-center grid">
    <div class="mech-select-stack">
      <div class="select-field">
        <label class="label-tech">Layout Profile</label>
        <div class="select-wrapper key-style">
          <select>
            <option>ANSI-US</option>
            <option>ISO-UK</option>
            <option>JIS-JP</option>
          </select>
        </div>
      </div>

      <div class="select-field">
        <label class="label-tech">System Mode</label>
        <div class="select-wrapper display-style">
          <select>
            <option>DEFAULT</option>
            <option>OVERCLOCK</option>
            <option>SLEEP_MODE</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mech-demo-container">
  <div class="section-title">Inputs</div>
  <div class="justify-center grid">
    <div class="mech-input-stack">
      <div class="input-field">
        <label>Keycap Style</label>
        <input type="text" class="input-keycap" placeholder="SEARCH..." />
      </div>

      <div class="input-field">
        <label>Digital Status</label>
        <div class="display-frame">
          <input
            type="text"
            class="input-display"
            placeholder="SYSTEM READY_"
          />
        </div>
      </div>

      <div class="input-field">
        <label>Industrial Slot</label>
        <input
          type="text"
          class="input-slot"
          placeholder="ENTER COMMAND..."
        />
      </div>
    </div>
  </div>
</div>

<div class="mech-demo-container">
  <div class="section-title">Cards</div>
  <div class="cards-container justify-center">
    <div class="mech-card status-card active">
      <div class="mech-card-header">System Status</div>
      <div class="mech-card-title">Main Console</div>
      <div class="mech-card-body">
        All systems operational. Network connection stable.
      </div>
      <div class="mech-card-footer">
        <span class="status-indicator">
          <span class="status-dot online"></span>
          ONLINE
        </span>
      </div>
    </div>

    <div class="mech-card data-card">
      <div class="mech-card-header">Data Readout</div>
      <div class="mech-card-title">Telemetry</div>
      <div class="data-row">
        <span class="data-label">Frequency</span>
        <span class="data-value highlight">98.7 MHz</span>
      </div>
      <div class="data-row">
        <span class="data-label">Signal</span>
        <span class="data-value">Strong</span>
      </div>
      <div class="data-row">
        <span class="data-label">Temp</span>
        <span class="data-value">24°C</span>
      </div>
    </div>

    <div class="mech-card control-card">
      <div class="mech-card-header">Controls</div>
      <div class="mech-card-title">Settings</div>
      <div class="control-row">
        <span class="control-label">Power</span>
        <label class="mini-switch">
          <input type="checkbox" checked />
          <span class="mini-track"><span class="mini-knob"></span></span>
        </label>
      </div>
      <div class="control-row">
        <span class="control-label">Audio</span>
        <label class="mini-switch">
          <input type="checkbox" />
          <span class="mini-track"><span class="mini-knob"></span></span>
        </label>
      </div>
      <div class="control-row">
        <span class="control-label">Radio</span>
        <label class="mini-switch">
          <input type="checkbox" checked />
          <span class="mini-track"><span class="mini-knob"></span></span>
        </label>
      </div>
    </div>
  </div>
</div>

<div class="mech-demo-container">
  <div class="section-title">Tables</div>
  <div class="mech-tables-container">
    <div class="table-wrapper">
      <label class="label-tech">System Status Log</label>
      <table class="mech-table-dark">
        <thead>
          <tr>
            <th>Module</th>
            <th>Status</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Processor</td>
            <td><span class="status-led"></span> Active</td>
            <td>0.85ms</td>
          </tr>
          <tr>
            <td>Backlight</td>
            <td><span class="status-led orange"></span> Warning</td>
            <td>40%</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="table-wrapper">
      <label class="label-tech">Parts Inventory</label>
      <table class="mech-table-light">
        <thead>
          <tr>
            <th>Part No.</th>
            <th>Color</th>
            <th>Stock</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="key-cell">K-75-C</td>
            <td>Cream</td>
            <td>120</td>
          </tr>
          <tr>
            <td class="key-cell orange">K-75-O</td>
            <td>Orange</td>
            <td>14</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="mech-demo-container">
  <div class="section-title">Progress</div>
  <label class="label-tech">Native Progress</label>
  <progress class="mech-progress-native" value="50" max="100"></progress>
</div>

    <div class="section-title">Dialog</div>
    <div class="mech-demo-container">
      <div class="dialog-demo-container justify-center">
        <button
          onclick="document.getElementById('dialog-standard').showModal()"
          class="keycap keycap-cream">Standard Dialog</button
        >

        <button
          onclick="document.getElementById('dialog-error').showModal()"
          class="trigger-btn error">Error Dialog</button
        >

        <button
          onclick="document.getElementById('dialog-terminal').showModal()"
          class="trigger-btn terminal">Terminal HUD</button
        >

        <dialog id="dialog-standard" class="mech-dialog standard">
          <div class="dialog-header">
            <span class="dot"></span>
            <span class="header-text">System Configuration</span>
          </div>
          <div class="dialog-body">
            <p>
              Adjusting the key debounce rate might affect response times.
              Proceed with the update?
            </p>
          </div>
          <form method="dialog" class="dialog-footer">
            <button class="btn-flat">ABORT</button>
            <button class="btn-raised">CONFIRM</button>
          </form>
        </dialog>

        <dialog id="dialog-error" class="mech-dialog alert">
          <div class="alert-stripe">CRITICAL FAILURE</div>
          <div class="dialog-body">
            <div class="alert-content">
              <span class="warning-icon">!</span>
              <p>Switch interference detected in Block-C. Connection lost.</p>
            </div>
          </div>
          <form method="dialog" class="dialog-footer">
            <button class="btn-outline">REBOOT SYSTEM</button>
          </form>
        </dialog>

        <dialog id="dialog-terminal" class="mech-dialog terminal">
          <div class="terminal-container">
            <div class="lines">
              <p>> INITIALIZING_CORE...</p>
              <p>> SYNCING_LED_DRIVERS... [DONE]</p>
              <p class="blink">> READY_FOR_COMMAND_</p>
            </div>
            <form method="dialog">
              <button class="close-x">×</button>
            </form>
          </div>
        </dialog>
      </div>
    </div>

    <div class="section-title">Badges</div>
    <div class="mech-demo-container">
      <div class="flex justify-center">
        <div class="mech-badge-panel">
          <div class="badge-group">
            <label class="label-tech">System LED</label>
            <div class="badge-led active">ONLINE</div>
            <div class="badge-led">OFFLINE</div>
            <div class="badge-led error">FAILURE</div>
          </div>

          <div class="badge-group">
            <label class="label-tech">Markings</label>
            <span class="badge-silk">REV_04</span>
            <span class="badge-silk orange">QC_PASSED</span>
          </div>

          <div class="badge-group">
            <label class="label-tech">Identification</label>
            <span class="badge-tag">MODEL: KB-88</span>
            <span class="badge-tag">S/N: 2026-X1</span>
          </div>
        </div>
      </div>
    </div>

    <div class="section-title">Text Area</div>
    <div class="mech-demo-container">
      <div class="grid justify-center">
        <div class="mech-textarea-stack">
          <div class="textarea-field">
            <label class="label-tech">System Log / Console</label>
            <textarea
              class="area-terminal"
              placeholder=">> WAITING FOR INPUT..."></textarea>
          </div>

          <div class="textarea-field">
            <label class="label-tech">Notes & Schematics</label>
            <textarea
              class="area-paper"
              placeholder="Enter technical notes here..."></textarea>
          </div>
        </div>
      </div>
    </div>

    <div class="section-title">Radio Buttons</div>
    <div class="mech-demo-container">
      <div class="flex justify-center">
        <div class="mech-radio-stack">
          <div class="radio-group">
            <label class="label-tech">Output Mode</label>
            <div class="radio-pads">
              <label class="pad-item">
                <input type="radio" name="mode" checked />
                <span class="pad-surface">AUX</span>
              </label>
              <label class="pad-item">
                <input type="radio" name="mode" />
                <span class="pad-surface">TAPE</span>
              </label>
              <label class="pad-item">
                <input type="radio" name="mode" />
                <span class="pad-surface">PHONO</span>
              </label>
            </div>
          </div>

          <div class="radio-group">
            <label class="label-tech">System Sync</label>
            <div class="radio-leds">
              <label class="led-item">
                <input type="radio" name="sync" checked />
                <span class="led-indicator"></span>
                <span class="led-text">INTERNAL</span>
              </label>
              <label class="led-item">
                <input type="radio" name="sync" />
                <span class="led-indicator"></span>
                <span class="led-text">EXTERNAL</span>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/src/js/CodeBlock.js"></script>
</Layout>
