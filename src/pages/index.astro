---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CassetteComponent from "../components/CassetteComponent.astro";
import "../styles/Buttons.css";
---

<Layout>
	<Header />
	<section class="grid justify-center gap-10 mt-5">
		<CassetteComponent
			title="Button"
			html=` _
			<button class="keycap keycap-cream">ESC</button>
			<button class="keycap keycap-grey">ENTER</button>
			<button class="keycap keycap-orange">SHIFT</button>
			`
			css=`.keycap {
  position: relative;
  display: inline-block;
  padding: 15px 20px;
  font-size: 1.1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border: none;
  border-radius: 12px; /* Bordes muy redondeados */
  cursor: pointer;
  transition: all 0.1s ease;
  
  /* Efecto de sombra 3D (el cuerpo de la tecla) */
  box-shadow: 
    0 8px 0 rgba(0,0,0,0.2),         /* Grosor principal de la tecla */
    0 10px 15px rgba(0,0,0,0.3),      /* Sombra proyectada en la base */
    inset 0 1px 1px rgba(255,255,255,0.3); /* Brillo superior interno */
}

/* Efecto de superficie cóncava/esférica (el "analógico") */
.keycap::before {
  content: "";
  position: absolute;
  top: 5px; right: 5px; bottom: 5px; left: 5px;
  border-radius: 9px;
  /* Degradado radial sutil para simular la curvatura */
  background: radial-gradient(circle at center, rgba(255,255,255,0.15) 0%, rgba(0,0,0,0.1) 100%);
  z-index: -1;
}

/* Variación Crema */
.keycap-cream {
  background-color: #f1ebd8;
  color: #555;
  box-shadow: 
    0 8px 0 #d8d0ba,                 /* Lado crema más oscuro */
    0 10px 15px rgba(0,0,0,0.2), 
    inset 0 1px 1px rgba(255,255,255,0.6);
}

/* Variación Gris (Gris Oscuro) */
.keycap-grey {
  background-color: #4a4a4a;
  color: #fff;
  box-shadow: 
    0 8px 0 #333,                    /* Lado gris más oscuro */
    0 10px 15px rgba(0,0,0,0.3), 
    inset 0 1px 1px rgba(255,255,255,0.1);
}

/* Variación Naranja */
.keycap-orange {
  background-color: #d65a31;
  color: #fff;
  box-shadow: 
    0 8px 0 #a94125,                 /* Lado naranja más oscuro */
    0 10px 15px rgba(0,0,0,0.3), 
    inset 0 1px 1px rgba(255,255,255,0.2);
}


/* Al pasar el ratón (ligeramente más claro) */
.keycap:hover {
  filter: brightness(1.05);
}

/* Botón Recessed (hundido/empotrado) */
.recessed-btn {
  position: relative;
  padding: 15px 20px;
  font-size: 1.1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #aaa;
  background-color: #2a2a2a;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  box-shadow: inset 0 4px 8px rgba(0,0,0,0.6), 0 2px 0 rgba(255,255,255,0.05);
  transition: all 0.1s ease;
}

.recessed-btn:active {
  background-color: #333;
  color: #d65a31;
  box-shadow: inset 0 2px 6px rgba(0,0,0,0.8), 0 1px 0 rgba(255,255,255,0.05);
  transform: translateY(1px);
}

/* Al pulsar (recorrido de la tecla) */
.keycap:active {
  box-shadow: 
    0 2px 0 rgba(0,0,0,0.2),         /* El grosor se comprime */
    0 2px 3px rgba(0,0,0,0.3);        /* La sombra de base disminuye */
  transform: translateY(6px);         /* La tecla "baja" */
}`
			<div
			class="buttons-container"
		>
			<button class="keycap keycap-cream">ESC</button>

			<button class="keycap keycap-grey">ENTER</button>

			<button class="keycap keycap-orange">SHIFT</button>
		</CassetteComponent>
	</section>

	<script src="/src/js/CodeBlock.js"></script>
</Layout>
